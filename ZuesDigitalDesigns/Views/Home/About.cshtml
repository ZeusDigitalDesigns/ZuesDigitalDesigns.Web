@{
    ViewData["Title"] = "About";
}

<div class="about-container" style="max-width: 1000px; margin: 0 auto; padding: 3rem 1rem;">
    
    <div style="text-align: center; margin-bottom: 3rem;">
        <h1 style="color: #1a252c; border-bottom: 4px solid #0476b1; display: inline-block;">
            The Builder Behind the Code
        </h1>
    </div>

    <!-- Flex container for image and text -->
    <div style="display: flex; flex-wrap: wrap; gap: 3rem; align-items: flex-start;">
        
        <!-- Left Column: Placeholder for Headshot -->
        <div style="flex: 1 1 300px; text-align: center;">
            <img src="https://placehold.co/400x500/1a252c/f4f7f6?text=Your+Photo" 
                 alt="About Image" 
                 style="width: 100%; max-width: 400px; border-radius: 8px; border-bottom: 5px solid #0476b1; box-shadow: 0 4px 10px rgba(0,0,0,0.1);" />
        </div>

        <!-- Right Column: The Narrative Meat -->
        <div style="flex: 2 1 400px; font-size: 1.15rem; color: #333;">
            <h2 style="color: #0476b1; margin-bottom: 1rem;">
                Built for the trades, by the trades.
            </h2>
            
            <p style="margin-bottom: 1.5rem;">
                [Placeholder: Paragraph 1 - Introduce yourself and your core 
                mission for Zues Digital Designs.]
            </p>
            
            <p style="margin-bottom: 1.5rem;">
                [Placeholder: Paragraph 2 - Drop in your background experience. 
                Talk about the CNC programming, the HVAC service days, and the 
                firefighting. Establish that blue-collar credibility.]
            </p>
            
            <p style="margin-bottom: 2rem;">
                [Placeholder: Paragraph 3 - Talk about the transition to software 
                engineering and how you bring that same rugged work ethic to 
                building applications.]
            </p>

            <a asp-controller="Contact" asp-action="Index" class="btn-cta">
                Let's Talk Shop
            </a>
        </div>
        
    </div>
</div>