<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zues Digital Designs</title>
    
    <!-- Link to the custom stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar">
        <div class="nav-brand">
            <a asp-controller="Home" asp-action="Index">
                Zues Digital Designs
            </a>
        </div>
        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>
                <a asp-controller="Portfolio" asp-action="Index">
                    Portfolio
                </a>
            </li>
            <li><a asp-controller="Home" asp-action="About">About</a></li>
            <li>
                <a asp-controller="Contact" asp-action="Index">
                    Contact
                </a>
            </li>
        </ul>
    </nav>
</header>
    
<main class="container">
    <!-- This is where individual page views get injected -->
    @RenderBody()
</main>

<footer class="site-footer">
    <p>
        &copy; @DateTime.Now.Year - Zues Digital Designs LLC. 
        Built for the trades.
    </p>
</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>