<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zues Digital Designs</title>
    
    <!-- BRAND FAVICONS GO HERE -->
    <link rel="icon" type="image/png" href="~/images/main-logo.png" />
    <link rel="apple-touch-icon" href="~/images/main-logo.png" />
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" 
          rel="stylesheet" />
          
    <!-- Link to the custom stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar">
        <div class="nav-brand">
            <!-- BRAND LOGO AND TEXT GO HERE -->
            <a asp-controller="Home" asp-action="Index" 
               style="display: flex; align-items: center; gap: 10px;">
                <img src="~/images/main-logo.png" 
                     alt="Zues Digital Designs Logo" 
                     style="height: 45px; width: auto;" />
                Zues Digital Designs
            </a>
        </div>
        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li>
                <a asp-controller="Portfolio" asp-action="Index">
                    Portfolio
                </a>
            </li>
            <li><a asp-controller="Home" asp-action="About">About</a></li>
            <li>
                <a asp-controller="Contact" asp-action="Index">
                    Contact
                </a>
            </li>
        </ul>
    </nav>
</header>
    
<main class="container">
    <!-- This is where individual page views get injected -->
    @RenderBody()
</main>

<footer class="site-footer">
    <p>
        &copy; @DateTime.Now.Year - Zues Digital Designs LLC. 
        Built for the trades.
    </p>
</footer>

<!-- Bootstrap 5 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>