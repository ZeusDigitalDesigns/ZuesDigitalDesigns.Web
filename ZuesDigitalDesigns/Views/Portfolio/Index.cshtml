@using ZuesDigitalDesigns.Models
@model List<Project>
@{
    ViewData["Title"] = "Our Work";
}

<div class="portfolio-container">
    <h1 class="portfolio-header">Recent Projects</h1>
    <p class="portfolio-subheader">
        Custom applications and sites built for the daily grind.
    </p>

    <!-- CSS Grid wrapper strictly for the dynamically generated cards -->
    <div class="project-grid">
        @foreach (Project project in Model)
        {
            <div class="project-card">
                <img src="@(string.IsNullOrEmpty(project.ImagePath) ? 
                            "https://placehold.co/600x400/1a252c/f4f7f6?text=UI" : 
                            project.ImagePath)" 
                     alt="@project.Title" 
                     class="project-img" />
                
                <div class="project-info">
                    <h3 class="project-title">@project.Title</h3>
                    
                    <p class="project-desc">
                        @project.Description
                    </p>
                    
                    <button type="button" 
                            class="btn-project" 
                            data-bs-toggle="modal" 
                            data-bs-target="#modal-@project.Id">
                        View Details
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modals must sit outside the custom CSS grid to stay hidden -->
@foreach (Project project in Model)
{
    <div class="modal fade" 
         id="modal-@project.Id" 
         tabindex="-1" 
         aria-labelledby="modalLabel-@project.Id" 
         aria-hidden="true">
        
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                
                <div class="modal-header">
                    <h5 class="modal-title" 
                        id="modalLabel-@project.Id">
                        @project.Title
                    </h5>
                    <button type="button" 
                            class="btn-close" 
                            data-bs-dismiss="modal" 
                            aria-label="Close"></button>
                </div>
                
                <div class="modal-body p-4">
                    
                    <!-- DYNAMIC PROJECT CAROUSEL -->
                    <!-- Binds directly to the project ID so controls don't overlap -->
                    <div id="carousel-@project.Id" class="carousel slide mb-4 shadow-sm rounded overflow-hidden" data-bs-ride="carousel">
                        
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#carousel-@project.Id" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carousel-@project.Id" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#carousel-@project.Id" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>

                        <div class="carousel-inner">
                            <!-- Slide 1: Primary Database Image -->
                            <div class="carousel-item active">
                                <img src="@(string.IsNullOrEmpty(project.ImagePath) ? 
                                            "https://placehold.co/800x500/1a252c/f4f7f6?text=Main+Dashboard" : 
                                            project.ImagePath)" 
                                     class="d-block w-100" 
                                     alt="@project.Title Main View">
                            </div>
                            
                            <!-- Slide 2: Feature View (Placeholder or Hardcoded) -->
                            <div class="carousel-item">
                                <img src="https://placehold.co/800x500/1a252c/f4f7f6?text=Feature+Detail+1" 
                                     class="d-block w-100" 
                                     alt="Feature View 1">
                            </div>
                            
                            <!-- Slide 3: Secondary Feature (Placeholder or Hardcoded) -->
                            <div class="carousel-item">
                                <img src="https://placehold.co/800x500/1a252c/f4f7f6?text=Feature+Detail+2" 
                                     class="d-block w-100" 
                                     alt="Feature View 2">
                            </div>
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#carousel-@project.Id" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carousel-@project.Id" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                    <!-- END CAROUSEL -->

                    <h6 class="fw-bold text-primary">The Problem</h6>
                    <p>@project.Problem</p>
                    
                    <h6 class="fw-bold text-primary mt-4">The Solution</h6>
                    <p>@project.Solution</p>
                    
                    <hr class="my-4" />
                    
                    <h6 class="fw-bold mb-3">Tech Stack</h6>
                    <div>
                        @if (!string.IsNullOrEmpty(project.TechStack)) 
                        {
                            foreach (string tech in project.TechStack.Split(','))
                            {
                                string cleanTech = tech.Trim();
                                
                                string badgeBg = cleanTech switch 
                                {
                                    "C#" => "bg-primary",
                                    ".NET 10" => "bg-primary",
                                    "ASP.NET Core MVC" => "bg-primary",
                                    "Avalonia UI" => "bg-danger",
                                    "EF Core" => "bg-info text-dark",
                                    "SQL Server" => "bg-info text-dark",
                                    "HTML/CSS" => "bg-warning text-dark",
                                    "Bootstrap 5" => "bg-success",
                                    _ => "bg-secondary"
                                };
                                
                                <span class="badge @badgeBg me-2 fs-6">
                                    @cleanTech
                                </span>
                            }
                        }
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" 
                            class="btn btn-outline-secondary" 
                            data-bs-dismiss="modal">
                        Close
                    </button>
                </div>
                
            </div>
        </div>
    </div>
}