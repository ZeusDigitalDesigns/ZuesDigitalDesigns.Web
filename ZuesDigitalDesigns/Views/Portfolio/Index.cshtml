@using ZuesDigitalDesigns.Models
@model List<Project>
@{
    ViewData["Title"] = "Our Work";
}

<div class="portfolio-container">
    <h1 class="portfolio-header">Recent Projects</h1>
    <p class="portfolio-subheader">
        Custom applications and sites built for the daily grind.
    </p>

    <!-- CSS Grid wrapper for the dynamically generated cards -->
    <div class="project-grid">
        
        @foreach (Project project in Model)
        {
            <!-- Dynamically generated Project Card -->
            <div class="project-card">
                <!-- Uses a fallback placeholder if the database ImagePath is empty -->
                <img src="@(string.IsNullOrEmpty(project.ImagePath) ? "https://placehold.co/600x400/1a252c/f4f7f6?text=Project+UI" : project.ImagePath)" 
                     alt="@project.Title" 
                     class="project-img" />
                
                <div class="project-info">
                    <h3 class="project-title">@project.Title</h3>
                    
                    <p class="project-desc">
                        @project.Description
                    </p>
                    
                    <!-- We will wire up the details routing in a future issue -->
                    <a href="#" class="btn-project">View Details</a>
                </div>
            </div>
        }

    </div>
</div>