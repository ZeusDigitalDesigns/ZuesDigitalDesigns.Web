@model ZuesDigitalDesigns.Models.ContactInquiry

<h1 class="text-brand-orange mb-4">Get a Quote</h1>

<!-- Ensure method="post" to trigger our HttpPost endpoint -->
<form asp-controller="Contact" asp-action="SubmitQuote" method="post">
    
    <!-- Anti-Forgery Token (Spam Protection) -->
    @Html.AntiForgeryToken()
    
    <!-- Honeypot Field (Spam Protection) -->
    <!-- Name it something tempting to a bot like 'Website' or 'Phone2' -->
    <input type="text" 
           name="BotTrapWebsite" 
           class="honey-pot-field" 
           tabindex="-1" 
           autocomplete="off" />

    <!-- This will print out exactly why ModelState is failing -->
    <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
    
    <!-- Standard Fields (Update these to match your model properties) -->
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Message" class="form-label">Project Details</label>
        <textarea asp-for="Message" class="form-control" rows="5" required>
        </textarea>
    </div>

    <button type="submit" class="btn btn-brand-orange">
        Send Request
    </button>
    </form>